FROM python:3.11.9-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN pip install --no-cache-dir httpx==0.28.1
COPY python-api/observation /app/observation
COPY python-api/phase3n_ha_worker.py /app/phase3n_ha_worker.py

USER 65532:65532
ENTRYPOINT ["python", "/app/phase3n_ha_worker.py"]
